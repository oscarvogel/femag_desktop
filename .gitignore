__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.venv_broken/
venv/
.env
backups/
# Editor tooling MCP (CodeGraph) — local to each machine
.codegraph/
.cursor/
# Local runtime outputs
outputs/
# Inno Setup build artifacts (the reproducible source lives in installer/*.iss)
installer/output/
# Demo installer per-day build counter (regenerated by scripts/build_demo_installer.ps1)
installer/.demo_build_state
build/
dist/
# Demo/validation databases (see AGENTS.md areas protegidas: datos demo)
femag_*.sqlite3
femag_*.sqlite3-journal
# Generated print and validation evidence
docs/prints/

# --- Local sensitive data (this repo is public) ---
# Env files: the ".env" rule above only matches that exact filename, so named
# env files such as managerial_summary.env stayed exposed. No .env is tracked.
*.env
# Database dumps. No .sql file is tracked in this repo.
*.sql
# Client documents: real personal and financial data, never versioned.
# No tracked file matches these prefixes (see output/pdf/ and docs/prints/).
extracto_*.pdf
presupuesto_*.pdf
recibo_*.pdf
orden_carga_*.pdf
# Local audit and test run outputs.
# No .csv is tracked in this repo, so these stay predictable.
*audit*.csv
*audit*.txt
/auditoria.txt
/log_test*.txt
/pytest_release.txt
