# Copiar fuera del checkout, por ejemplo a C:\ProgramData\FEMAG\webapp.env.
# No versionar la copia real: contiene la credencial de la base.
APP_ENV=production
FEMAG_DB_ENGINE=mysql
FEMAG_AUTO_MIGRATE_SCHEMA=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=femag_desktop
DB_USER=REEMPLAZAR_POR_USUARIO_WEBAPP
DB_PASSWORD=REEMPLAZAR_POR_CLAVE_SEGURA
