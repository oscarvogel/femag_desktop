# Copiar fuera del checkout, por ejemplo a C:\ProgramData\FEMAG\webapp.env.
# No versionar la copia real: contiene la credencial de la base.
#
# El despliegue (`scripts\deploy_webapp_server.ps1`) genera este archivo solo la
# primera vez y lo protege con permisos: lo lee SYSTEM y lo administran los
# administradores. No hay que volver a tocarlo en cada re-despliegue.
APP_ENV=production
FEMAG_DB_ENGINE=mysql

# El servicio web NO puede crear ni alterar tablas. La migracion de esquema la
# aplica un administrador, desde FEMAG Desktop ("Crear o actualizar ahora las
# tablas de FEMAG") o con scripts\init_db.py.
FEMAG_AUTO_MIGRATE_SCHEMA=0

# En la fabrica MySQL corre en el mismo Windows Server 2019, asi que la
# webapp y la base se hablan por loopback.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=femag_desktop
DB_USER=REEMPLAZAR_POR_USUARIO_WEBAPP
DB_PASSWORD=REEMPLAZAR_POR_CLAVE_SEGURA

# URL publica del servidor: es la que se imprime en el QR de cada turno, asi
# que tiene que ser la que el celular puede abrir. El despliegue la define con
# -PublicHostName y la pasa al servicio; si se cambia aca, el despliegue la
# toma de este archivo. Debe empezar con https://, porque la camara del
# celular solo funciona en un contexto seguro.
#
# El nombre no debe terminar en ".local": la RFC 6762 reserva ese sufijo para
# mDNS y los celulares resuelven los nombres .local por multicast, no por el
# DNS de la LAN.
FEMAG_WEB_PUBLIC_URL=https://femag.lan

# Archivo donde vive el secreto con el que se firman las cookies de sesion.
# Se deja fuera del perfil de SYSTEM para que sobreviva a los reinicios y
# quede protegido junto con la configuracion.
FEMAG_WEB_SECRET_FILE=C:\ProgramData\FEMAG\webapp_secret.key
