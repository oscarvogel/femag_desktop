APP_ENV=development
FEMAG_DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=femag
DB_USER=femag
DB_PASSWORD=
BACKUP_DIR=backups
BACKUP_EXTRA_DIR=
LOG_LEVEL=INFO
FEMAG_SMTP_HOST=
FEMAG_SMTP_PORT=587
FEMAG_SMTP_USER=
FEMAG_SMTP_PASSWORD=
FEMAG_SMTP_FROM=
FEMAG_SMTP_USE_TLS=true

# WhatsApp se configura centralmente desde Sistema > WhatsApp.
# Las variables WHATSAPP_* sólo se conservan como compatibilidad transitoria
# en instalaciones anteriores y no deben configurarse en instalaciones nuevas.

# Preferir el numero de WhatsApp dedicado (campo whatsapp_phone) sobre el
# telefono general. Apagado por defecto: lo activa el administrador cuando
# los numeros estan cargados.
FEMAG_WHATSAPP_DEDICADO=0

# Origen legacy de recepciones. Reutiliza host/puerto/usuario/clave de FEMAG Desktop y cambia sólo la base.
FEMAGFAB_DB_NAME=femagfab
FEMAGFAB_SOURCE_INSTANCE=femagfab

# ---------------------------------------------------------------------------
# Precarga asistida por IA de ordenes de despacho (foto/PDF) - issue #913
# ---------------------------------------------------------------------------
# El proveedor ya esta elegido: alcanza con pegar la API key y reiniciar el
# servidor web (FEMAG Webapp Server) y/o FEMAG Desktop, segun donde se use.
# El instalador del escritorio crea %LOCALAPPDATA%\FEMAG Desktop\.env y el del
# servidor crea C:\ProgramData\FEMAG\webapp.env con estas mismas variables.
# Sin clave, la funcion queda deshabilitada y la carga manual sigue igual.
#
# El endpoint internacional de MiniMax es https://api.minimax.io/v1.
# Si la cuenta es de China continental, usar https://api.minimaxi.com/v1.
# Modelos multimodales soportados: MiniMax-M3.1-Flash y MiniMax-M3.
FEMAG_ORDER_CAPTURE_AI_PROVIDER=minimax
FEMAG_ORDER_CAPTURE_AI_API_KEY=
FEMAG_ORDER_CAPTURE_AI_MODEL=MiniMax-M3.1-Flash
FEMAG_ORDER_CAPTURE_AI_BASE_URL=https://api.minimax.io/v1
FEMAG_ORDER_CAPTURE_AI_TIMEOUT_SECONDS=60
FEMAG_ORDER_CAPTURE_AI_DETAIL=high

# Limites de la carga. Las fotos de celular se achican solas antes de enviarse.
FEMAG_ORDER_CAPTURE_MAX_MB=10
# Para PDF se convierte cada pagina en imagen; por eso el maximo de paginas.
FEMAG_ORDER_CAPTURE_MAX_PAGES=3

# Cuota blanda por usuario para evitar costos accidentales (por proceso).
FEMAG_ORDER_CAPTURE_RATE_LIMIT_PER_HOUR=10
