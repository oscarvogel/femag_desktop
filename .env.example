APP_ENV=development
FEMAG_DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=femag
DB_USER=femag
DB_PASSWORD=
BACKUP_DIR=backups
BACKUP_EXTRA_DIR=
LOG_LEVEL=INFO
FEMAG_SMTP_HOST=
FEMAG_SMTP_PORT=587
FEMAG_SMTP_USER=
FEMAG_SMTP_PASSWORD=
FEMAG_SMTP_FROM=
FEMAG_SMTP_USE_TLS=true

# WhatsApp se configura centralmente desde Sistema > WhatsApp.
# Las variables WHATSAPP_* sólo se conservan como compatibilidad transitoria
# en instalaciones anteriores y no deben configurarse en instalaciones nuevas.

# Origen legacy de recepciones (solo lectura). Usar un usuario MySQL con SELECT únicamente.
FEMAGFAB_DB_HOST=127.0.0.1
FEMAGFAB_DB_PORT=3306
FEMAGFAB_DB_NAME=femagfab
FEMAGFAB_DB_USER=
FEMAGFAB_DB_PASSWORD=
FEMAGFAB_SOURCE_INSTANCE=femagfab
