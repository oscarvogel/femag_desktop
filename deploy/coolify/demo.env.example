# Copiar a deploy/coolify/demo.env y completar con valores propios.
# demo.env esta ignorado por git (*.env). No usar estas claves en produccion.

DB_NAME=femag_web
DB_USER=femag
DB_PASSWORD=cambiar-clave-demo
MYSQL_ROOT_PASSWORD=cambiar-root-demo

FEMAG_WEB_SECRET_KEY=cambiar-secreto-de-sesion-largo-y-aleatorio
FEMAG_WEB_PUBLIC_URL=http://localhost:8080
WEB_PORT=8080

FEMAG_WEB_AUTO_INIT_SCHEMA=1
FEMAG_WEB_SEED_DEMO=1
FEMAG_DEMO=1
FEMAG_WEB_DEMO_ADMIN_USER=demo
FEMAG_WEB_DEMO_ADMIN_PASSWORD=cambiar-clave-demo-web
FEMAG_WEB_DEMO_ORDER_TOKEN=demo-web-order-2026
# FEMAG_SYNC_API_TOKEN=cambiar-token-de-maquina  # habilitar al conectar el agente de #804

# Precarga asistida por IA de lotes/fechas (#913). El proveedor ya esta
# elegido: alcanza con pegar una API key de MiniMax. Sin clave queda
# deshabilitada y la carga manual sigue funcionando.
# Internacional: https://api.minimax.io/v1 | China: https://api.minimaxi.com/v1
FEMAG_ORDER_CAPTURE_AI_PROVIDER=minimax
FEMAG_ORDER_CAPTURE_AI_API_KEY=
FEMAG_ORDER_CAPTURE_AI_MODEL=MiniMax-M3.1-Flash
FEMAG_ORDER_CAPTURE_AI_BASE_URL=https://api.minimax.io/v1
