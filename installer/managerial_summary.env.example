# FEMAG Managerial Summary - configuracion del job de Windows Server
# La conexion MySQL se reutiliza desde las credenciales seguras de FEMAG Desktop.
# Este archivo debe copiarse como:
#   %LOCALAPPDATA%\FEMAG Desktop\managerial_summary.env

FEMAG_MANAGERIAL_AUTO_ENABLED=true

# WhatsApp del destinatario en formato internacional, solo digitos.
FEMAG_MANAGERIAL_WHATSAPP=

# Instancia de Vogel WhatsApp API usada exclusivamente para el resumen gerencial.
FEMAG_MANAGERIAL_WHATSAPP_INSTANCE=

# Email del destinatario gerencial. Dejar vacio para deshabilitar email.
FEMAG_MANAGERIAL_EMAIL=

# SMTP. Solo es obligatorio si FEMAG_MANAGERIAL_EMAIL tiene valor.
FEMAG_SMTP_HOST=
FEMAG_SMTP_PORT=587
FEMAG_SMTP_USER=
FEMAG_SMTP_PASSWORD=
FEMAG_SMTP_FROM=
FEMAG_SMTP_USE_TLS=true
